{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "airprompter",
  "version": "0.2.7",
  "description": "AirPrompter connects Hermes to your saved prompt and workflow library. AirPrompter keeps a record of each run, including your inputs, step status, timing, and token counts; the README explains what is recorded.",
  "author": {
    "name": "AirPrompter",
    "email": "support@airprompter.com",
    "url": "https://airprompter.com"
  },
  "homepage": "https://airprompter.com",
  "repository": "https://github.com/airprompter/airprompter-hermes-plugin",
  "license": "MIT",
  "keywords": [
    "airprompter",
    "prompts",
    "workflows",
    "mcp"
  ],
  "extensions": {
    "com.nousresearch.hermes": {
      "servers": {
        "airprompter": {
          "trust": "untrusted"
        }
      }
    }
  }
}
